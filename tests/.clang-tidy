# The tests follow the org clang-tidy configuration (_config/.clang-tidy, linked to the root by CI). These checks
# are off here because the code they would change is test scaffolding, never shipped:
#   readability-convert-member-functions-to-static  mock ports keep their hooks as instance methods: the driver
#                                                   calls a port object (the port contract), whatever the hook does
#   readability-make-member-function-const         the port hooks keep the contract's non-const signature
#   clang-analyzer-optin.performance.Padding        the mock chip lists its registers in the manual's order, not
#                                                   in the order that packs best
#   cppcoreguidelines-non-private-member-variables-in-classes  the mock chip exposes its state for the tests to
#                                                   set and read
#   cppcoreguidelines-macro-usage                   TEST_CASE / CHECK are macros so they can report file and line
#   cppcoreguidelines-avoid-c-arrays, modernize-avoid-c-arrays  the mock register file and the test registry
#   modernize-use-designated-initializers           the test registry's two-field entries
#   cppcoreguidelines-pro-type-vararg               the test runner and the fuzz replay print their report with
#                                                   std::printf on the host; the driver itself never formats text
#   clang-analyzer-optin.core.EnumCastOutOfRange  the tests cast out-of-range values on purpose to reach the
#                                                   driver's rejection paths
#   cppcoreguidelines-pro-type-reinterpret-cast   the tests view a string's bytes as uint8_t to build frames
#   cppcoreguidelines-pro-type-member-init        golden-case structs are filled by aggregate initialisation
#   performance-inefficient-string-concatenation  test messages and expected wires are built once
InheritParentConfig: true
Checks: >-
  -readability-convert-member-functions-to-static,
  -readability-make-member-function-const,
  -clang-analyzer-optin.performance.Padding,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-avoid-c-arrays,
  -modernize-avoid-c-arrays,
  -modernize-use-designated-initializers,
  -cppcoreguidelines-pro-type-vararg,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-member-init,
  -performance-inefficient-string-concatenation
