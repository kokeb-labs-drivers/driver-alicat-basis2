#ifndef ALICAT_BASIS2_VERSION_H
#define ALICAT_BASIS2_VERSION_H

/** Major version: incompatible API changes. */
#define ALICAT_BASIS2_VERSION_MAJOR @ALICAT_BASIS2_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define ALICAT_BASIS2_VERSION_MINOR @ALICAT_BASIS2_VERSION_MINOR@
/** Patch version: fixes. */
#define ALICAT_BASIS2_VERSION_PATCH @ALICAT_BASIS2_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define ALICAT_BASIS2_VERSION_STRING "@ALICAT_BASIS2_VERSION@"

#endif // ALICAT_BASIS2_VERSION_H
